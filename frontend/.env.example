# Server-side API base (preferred for Server Components)
API_BASE_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Browser-side API base (must point at the Express backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Canonical public site URL (sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (optional) — site key for inquiry/newsletter widgets
# Backend must set TURNSTILE_SECRET_KEY for verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Website settings note: receptionHours is managed in Admin → Settings (stored on WebsiteSetting)
