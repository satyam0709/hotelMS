DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hotellms"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="1d"
FRONTEND_ORIGIN="http://localhost:3000"
COOKIE_NAME="hotel_admin_access"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

BOOKING_HOLD_TTL_MINUTES="30"
ADMIN_NOTIFICATION_EMAIL=""

# First admin bootstrap (set a unique password before creating the first admin)
DEFAULT_ADMIN_NAME="HotelMS Super Admin"
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_USERNAME=""
DEFAULT_ADMIN_PASSWORD=""
# DEFAULT_ADMIN_UPDATE_PASSWORD="true"  # set only when you intentionally want seed to reset this user's password

# Optional shared marketplace demo account (read-only; set only on the demo deployment)
DEMO_READ_ONLY_ENABLED="false"
DEMO_READ_ONLY_NAME="HotelMS Demo Viewer"
DEMO_READ_ONLY_EMAIL=""
DEMO_READ_ONLY_USERNAME=""
DEMO_READ_ONLY_PASSWORD=""
# DEMO_READ_ONLY_UPDATE_PASSWORD="true"  # explicitly rotate an existing demo account password

# Media (Cloudinary) — required for POST /api/admin/media/upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="hotelms"
# CLOUDINARY_REQUIRED="true"  # enforce credentials in production

# Payments (Razorpay) — required for ONLINE paymentMethod
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudflare Turnstile (optional) — when set, POST /inquiries and newsletter require captchaToken
TURNSTILE_SECRET_KEY=""
# Pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the frontend

# Email (SMTP) — optional in development (writes to .local-email-outbox.jsonl)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
EMAIL_FROM=""
PASSWORD_RESET_URL="http://localhost:3000/admin/reset-password"
